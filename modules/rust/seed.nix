# Rendering `crates.<member>.<dep>` into a seed workspace.
#
# A seed workspace is a Cargo workspace that is NEVER COMPILED. Its members exist
# purely to name dependencies, so that `cargo generate-lockfile` produces one
# lock spanning the union of everything the environment might want offline. That
# lock is then turned into a vendored directory source.
#
# Members that could never be *built* together are fine here -- four mutually
# exclusive HALs, each with its own `critical-section` and time-driver
# implementation, resolve happily because resolution only unions dependency
# graphs and never type-checks anything.
#
# They are split across members rather than heaped into one manifest for a
# concrete reason: cargo's resolver takes pathologically long to unify several
# mutually exclusive HALs inside a single package, and returns in seconds when
# they are separate ones.
{ lib, pkgs }:
let
  # TOML is emitted by hand rather than through `pkgs.formats.toml`, for two
  # reasons: dependency specs want the compact `name = { version = "..", ... }`
  # inline-table form that a generic writer will not produce, and
  # `extraManifest` has to be appended *inside* the `[dependencies]` table --
  # TOML forbids reopening it, so the raw text cannot simply be concatenated
  # onto a generated file.
  str = s: ''"${lib.escape [ ''"'' "\\" ] s}"'';

  list = xs: "[${lib.concatMapStringsSep ", " str xs}]";

  renderDep =
    depName: dep:
    let
      fields =
        lib.optional (dep.version != null) "version = ${str dep.version}"
        ++ lib.optional (dep.package != null) "package = ${str dep.package}"
        ++ lib.optional (dep.features != [ ]) "features = ${list dep.features}"
        ++ lib.optional (!dep.defaultFeatures) "default-features = false";
    in
    if fields == [ ] then
      throw "offline-devshells: seed dependency `${depName}' specifies nothing; give it at least a `version'."
    # The shorthand form, for the common case of a bare version requirement.
    else if fields == [ "version = ${str dep.version}" ] then
      "${depName} = ${str dep.version}"
    else
      "${depName} = { ${lib.concatStringsSep ", " fields} }";

  memberManifest =
    member: deps: extra:
    ''
      # GENERATED by offline-devshells from `rust.modes.<mode>.crates.${member}`.
      # Never compiled -- see ../../Cargo.toml.
      [package]
      name = "seed-${member}"
      edition.workspace = true
      version.workspace = true
      publish.workspace = true

      [dependencies]
    ''
    + lib.concatStringsSep "\n" (lib.mapAttrsToList renderDep deps)
    + "\n"
    + lib.optionalString (extra != "") ("\n" + extra + "\n");

  rootManifest =
    { members, edition }:
    ''
      # GENERATED by offline-devshells. Dependency-superset workspace: these
      # crates are never compiled, they exist only to produce a Cargo.lock
      # covering everything the offline environment needs.
      [workspace]
      resolver = "2"
      members = [
      ${lib.concatMapStrings (m: "    ${str "crates/${m}"},\n") members}]

      [workspace.package]
      edition = ${str edition}
      version = "0.0.0"
      publish = false
    '';
in
{
  inherit renderDep;

  # `crates` and `extraManifest` in, a workspace directory in the store out.
  mkSeed =
    {
      name,
      crates,
      extraManifest ? { },
      edition ? "2021",
    }:
    let
      members = lib.attrNames crates;
      files = lib.mapAttrsToList (member: deps: {
        inherit member;
        manifest = pkgs.writeText "seed-${member}-Cargo.toml" (
          memberManifest member deps (extraManifest.${member} or "")
        );
      }) crates;
      root = pkgs.writeText "seed-Cargo.toml" (rootManifest {
        inherit members edition;
      });
    in
    pkgs.runCommandLocal "${name}-seed" { } (
      ''
        mkdir -p $out
        cp ${root} $out/Cargo.toml
      ''
      + lib.concatMapStrings (f: ''
        mkdir -p $out/crates/${f.member}/src
        cp ${f.manifest} $out/crates/${f.member}/Cargo.toml
        echo '// Dependency-superset stub. Never compiled; see ../../Cargo.toml.' \
          > $out/crates/${f.member}/src/lib.rs
      '') files
    );
}
